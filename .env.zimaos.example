# Imagens publicas multiarch acompanhadas automaticamente no ambiente de portfolio.
BFF_IMAGE=ghcr.io/matheus22003/finance-control-bff:develop
FINANCE_IMAGE=ghcr.io/matheus22003/finance-control-finance-service:develop
DEBT_IMAGE=ghcr.io/matheus22003/finance-control-debt-service:develop

# Necessario somente ao ativar o profile "public".
# Crie uma conta gratuita em myzrok.io e nunca versione o token real.
ZROK2_ENABLE_TOKEN=replace-with-zrok-account-token
ZROK2_SHARE_NAME=finance-control

FRONTEND_PUBLIC_URL=https://finance-control-frontend-gamma.vercel.app

BFF_JWT_ISSUER=finance-control-bff
BFF_JWT_AUDIENCE=finance-control-frontend
BFF_JWT_KEY=replace-with-at-least-32-random-bytes
BFF_JWT_EXPIRES_MINUTES=15
BFF_REFRESH_TOKEN_DAYS=30
BFF_AUTH_SENSITIVE_PERMIT_LIMIT=10

BFF_EMAIL_FROM_ADDRESS=verified-sender@example.org
BFF_EMAIL_FROM_NAME=Finance Control
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_TIMEOUT_SECONDS=30

BFF_DEMO_EMAIL=demo@example.org
BFF_DEMO_PASSWORD=replace-with-a-strong-demo-password
BFF_FRIEND_EMAIL=
BFF_FRIEND_PASSWORD=

BFF_DATABASE_CONNECTION_STRING=Host=ep-example.sa-east-1.aws.neon.tech;Port=5432;Database=finance_control_bff;Username=neondb_owner;Password=replace-me;SSL Mode=Require;Channel Binding=Require
DEBT_DATABASE_CONNECTION_STRING=Host=ep-example.sa-east-1.aws.neon.tech;Port=5432;Database=finance_control_debt;Username=neondb_owner;Password=replace-me;SSL Mode=Require;Channel Binding=Require

FINANCE_DATABASE_JDBC_URL=jdbc:postgresql://ep-example.sa-east-1.aws.neon.tech/finance_control_finance?sslmode=require&channelBinding=require
FINANCE_DATABASE_USERNAME=neondb_owner
FINANCE_DATABASE_PASSWORD=replace-me
FINANCE_SERVICE_TIMEOUT_SECONDS=10
DEBT_SERVICE_TIMEOUT_SECONDS=10

AI_PROVIDER=OpenAiCompatible
AI_BASE_URL=https://api.groq.com/openai/v1/
AI_API_KEY=replace-with-groq-api-key
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_USE_JSON_RESPONSE_FORMAT=false
AI_APPLICATION_NAME=Finance Control
