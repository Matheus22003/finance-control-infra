BESZEL_BIND_ADDRESS=0.0.0.0
BESZEL_PORT=8090
BESZEL_APP_URL=http://localhost:8090

# Preencha com as credenciais exclusivas geradas em "Adicionar Sistema" no Hub.
BESZEL_AGENT_TOKEN=replace-with-beszel-system-token
BESZEL_AGENT_KEY=replace-with-beszel-system-public-key

# Mantido vazio localmente; o helper grava a URL Push apenas no ZimaOS.
BESZEL_HEARTBEAT_URL=
BESZEL_HEARTBEAT_INTERVAL=60
BESZEL_HEARTBEAT_METHOD=POST

UPTIME_KUMA_BIND_ADDRESS=0.0.0.0
UPTIME_KUMA_PORT=3001
