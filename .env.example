BFF_PORT=8080
FRONTEND_PORT=4200
MAILPIT_WEB_PORT=8025

BFF_JWT_ISSUER=finance-control-bff
BFF_JWT_AUDIENCE=finance-control-frontend
BFF_JWT_KEY=local-compose-jwt-key-change-before-production-2026
BFF_JWT_EXPIRES_MINUTES=15
BFF_REFRESH_TOKEN_DAYS=30
BFF_AUTH_SENSITIVE_PERMIT_LIMIT=10
BFF_EMAIL_FROM_ADDRESS=no-reply@financecontrol.local
BFF_EMAIL_FROM_NAME=Finance Control
BFF_DEMO_EMAIL=demo@financecontrol.local
BFF_DEMO_PASSWORD=ChangeMe123!
BFF_FRIEND_EMAIL=friend@financecontrol.local
BFF_FRIEND_PASSWORD=ChangeMe123!

# Mock funciona sem chave. Para Groq, use OpenAiCompatible e informe AI_API_KEY.
AI_PROVIDER=Mock
AI_BASE_URL=https://api.groq.com/openai/v1/
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_USE_JSON_RESPONSE_FORMAT=false
AI_APPLICATION_URL=
AI_APPLICATION_NAME=Finance Control

BFF_DB_NAME=finance_control_bff
BFF_DB_USER=bff_app
BFF_DB_PASSWORD=local_bff_password

FINANCE_DB_NAME=finance_control_finance
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=local_finance_password
FINANCE_SERVICE_TIMEOUT_SECONDS=5

DEBT_DB_NAME=finance_control_debt
DEBT_DB_USER=debt_app
DEBT_DB_PASSWORD=local_debt_password
DEBT_SERVICE_TIMEOUT_SECONDS=5
