# Imagens públicas multiarch publicadas no GHCR. Prefira tags de versão imutáveis.
BFF_IMAGE=ghcr.io/matheus22003/finance-control-bff:0.2.0
FINANCE_IMAGE=ghcr.io/matheus22003/finance-control-finance-service:0.2.0
DEBT_IMAGE=ghcr.io/matheus22003/finance-control-debt-service:0.2.0

# Subdomínio DuckDNS gratuito apontado ao IPv4 público da VM, sem https:// e sem caminho.
BFF_PUBLIC_HOST=finance-control-api.duckdns.org
FRONTEND_PUBLIC_URL=https://finance-control.pages.dev
ACME_EMAIL=owner@example.org

# Gere com: openssl rand -base64 48 | tr -d '=+/\n' | head -c 64
ORIGIN_VERIFY_TOKEN=replace-with-a-random-origin-token

BFF_JWT_ISSUER=finance-control-bff
BFF_JWT_AUDIENCE=finance-control-frontend
BFF_JWT_KEY=replace-with-at-least-32-random-bytes
BFF_JWT_EXPIRES_MINUTES=15
BFF_REFRESH_TOKEN_DAYS=30
BFF_AUTH_SENSITIVE_PERMIT_LIMIT=10

BFF_EMAIL_FROM_ADDRESS=verified-sender@example.org
BFF_EMAIL_FROM_NAME=Finance Control
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_TIMEOUT_SECONDS=30

BFF_DEMO_EMAIL=demo@example.org
BFF_DEMO_PASSWORD=replace-with-a-strong-demo-password
BFF_FRIEND_EMAIL=
BFF_FRIEND_PASSWORD=

# Neon BFF e Debt: use o formato Npgsql e mantenha SSL Mode=Require.
BFF_DATABASE_CONNECTION_STRING=Host=ep-example.neon.tech;Port=5432;Database=finance_control_bff;Username=bff_owner;Password=replace-me;SSL Mode=Require;Channel Binding=Require
DEBT_DATABASE_CONNECTION_STRING=Host=ep-example.neon.tech;Port=5432;Database=finance_control_debt;Username=debt_owner;Password=replace-me;SSL Mode=Require;Channel Binding=Require

# Neon Finance: URL JDBC e credenciais do projeto Finance, nunca dos outros bancos.
FINANCE_DATABASE_JDBC_URL=jdbc:postgresql://ep-example.neon.tech/finance_control_finance?sslmode=require&channelBinding=require
FINANCE_DATABASE_USERNAME=finance_owner
FINANCE_DATABASE_PASSWORD=replace-me
FINANCE_SERVICE_TIMEOUT_SECONDS=10
DEBT_SERVICE_TIMEOUT_SECONDS=10

AI_PROVIDER=OpenAiCompatible
AI_BASE_URL=https://api.groq.com/openai/v1/
AI_API_KEY=replace-with-groq-api-key
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_USE_JSON_RESPONSE_FORMAT=false
AI_APPLICATION_NAME=Finance Control
